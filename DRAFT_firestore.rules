rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'f13051597@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 2 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSha256Id(id) {
      return id is string && id.size() == 64 && id.matches('^[a-f0-9]{64}$');
    }

    function isValidDateString(d) {
      return d is string && d.size() == 10 && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isCoreDepartmentId(deptId) {
      return deptId in [
        'orthopedics',
        'emergency',
        'icu',
        'medicine-ward',
        'surgery-ward',
        'gynecology-ward',
        'neonatal-pediatrics'
      ];
    }

    function isCoreDoctorId(docId) {
      return docId in [
        'dr-kumud-limbu',
        'dr-keshar-bahadur-gurung',
        'dr-sachin-silapkar',
        'dr-laxam-rana-magar',
        'dr-prem-bahadur-shahi',
        'dr-dharmapal-ray'
      ];
    }

    function isDepartmentBookable(deptId) {
      return (exists(/databases/$(database)/documents/departments/$(deptId))
        && get(/databases/$(database)/documents/departments/$(deptId)).data.isActive == true)
        || (!exists(/databases/$(database)/documents/departments/$(deptId)) && isCoreDepartmentId(deptId));
    }

    function isDoctorBookable(docId) {
      return (exists(/databases/$(database)/documents/doctors/$(docId))
        && get(/databases/$(database)/documents/doctors/$(docId)).data.isAvailable == true)
        || (!exists(/databases/$(database)/documents/doctors/$(docId)) && isCoreDoctorId(docId));
    }

    function expectedSlotLockId(doctorId, appointmentDate, timeSlot) {
      return doctorId + '_' + appointmentDate + '_' + timeSlot.replace('[^a-zA-Z0-9]', '');
    }

    function isValidDepartment(data) {
      return data.keys().hasAll(['id', 'name', 'summary', 'careScope', 'is24x7', 'isActive', 'sortOrder', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'nepaliName', 'summary', 'careScope', 'is24x7', 'isActive', 'sortOrder', 'updatedAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && (!('nepaliName' in data) || (data.nepaliName is string && data.nepaliName.size() <= 120))
        && data.summary is string && data.summary.size() <= 400
        && data.careScope is string && data.careScope.size() <= 400
        && data.is24x7 is bool
        && data.isActive is bool
        && data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 1000
        && data.updatedAt is timestamp;
    }

    function isValidDoctor(data) {
      return data.keys().hasAll(['id', 'name', 'specialty', 'departmentId', 'opdFee', 'isAvailable', 'availableSlots', 'sortOrder', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'specialty', 'qualification', 'nmcNo', 'opdSchedule', 'photoUrl', 'clinicalFocus', 'departmentId', 'opdFee', 'isAvailable', 'availableSlots', 'sortOrder', 'updatedAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.specialty is string && data.specialty.size() <= 150
        && (!('qualification' in data) || (data.qualification is string && data.qualification.size() <= 350))
        && (!('nmcNo' in data) || (data.nmcNo is string && data.nmcNo.size() <= 30))
        && (!('opdSchedule' in data) || (data.opdSchedule is string && data.opdSchedule.size() <= 100))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 150000))
        && (!('clinicalFocus' in data) || (data.clinicalFocus is string && data.clinicalFocus.size() <= 500))
        && isValidId(data.departmentId)
        && data.opdFee is number && data.opdFee >= 0 && data.opdFee <= 50000
        && data.isAvailable is bool
        && data.availableSlots is list && data.availableSlots.size() <= 16
        && (data.availableSlots.size() == 0 || (data.availableSlots[0] is string && data.availableSlots[0].size() >= 3 && data.availableSlots[0].size() <= 20))
        && data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 1000
        && data.updatedAt is timestamp;
    }

    function isValidBookedSlot(data) {
      return data.keys().hasAll(['doctorId', 'appointmentDate', 'timeSlot', 'appointmentId', 'status', 'createdAt'])
        && data.keys().hasOnly(['doctorId', 'appointmentDate', 'timeSlot', 'appointmentId', 'status', 'createdAt'])
        && isValidId(data.doctorId)
        && isValidDateString(data.appointmentDate)
        && data.timeSlot is string && data.timeSlot.size() >= 3 && data.timeSlot.size() <= 20
        && isValidId(data.appointmentId)
        && data.status == 'active'
        && data.createdAt is timestamp;
    }

    function isValidAppointment(data) {
      return data.keys().hasAll([
          'bookingId', 'patientName', 'mobileNumber', 'age', 'gender',
          'departmentId', 'departmentName', 'doctorId', 'doctorName',
          'opdFee', 'appointmentDate', 'timeSlot', 'reason', 'status',
          'slotLockId', 'statusLookupId', 'adminNote', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'bookingId', 'patientName', 'mobileNumber', 'age', 'gender',
          'departmentId', 'departmentName', 'doctorId', 'doctorName',
          'opdFee', 'appointmentDate', 'timeSlot', 'reason', 'status',
          'slotLockId', 'statusLookupId', 'adminNote',
          'reminderTiming', 'reminderChannel', 'reminderStatus',
          'createdAt', 'updatedAt'
        ])
        && data.bookingId is string && data.bookingId.size() == 15 && data.bookingId.matches('^SXH-[0-9]{4}-[A-Z0-9]{6}$')
        && data.patientName is string && data.patientName.size() >= 2 && data.patientName.size() <= 100
        && data.mobileNumber is string && data.mobileNumber.size() >= 7 && data.mobileNumber.size() <= 15 && data.mobileNumber.matches('^[0-9]{7,15}$')
        && data.age is number && data.age >= 0 && data.age <= 120
        && data.gender in ['Male', 'Female', 'Other', 'Prefer not to say', '']
        && isValidId(data.departmentId)
        && data.departmentName is string && data.departmentName.size() >= 2 && data.departmentName.size() <= 100
        && isValidId(data.doctorId)
        && data.doctorName is string && data.doctorName.size() >= 2 && data.doctorName.size() <= 100
        && data.opdFee is number && data.opdFee >= 0 && data.opdFee <= 50000
        && isValidDateString(data.appointmentDate)
        && data.timeSlot is string && data.timeSlot.size() >= 3 && data.timeSlot.size() <= 20
        && data.reason is string && data.reason.size() <= 500
        && data.status in ['pending', 'approved', 'rejected', 'completed', 'cancelled']
        && isValidId(data.slotLockId)
        && isValidSha256Id(data.statusLookupId)
        && data.adminNote is string && data.adminNote.size() <= 300
        && (!('reminderTiming' in data) || data.reminderTiming in ['24_hours_before', '2_hours_before', 'morning_of_visit', 'none'])
        && (!('reminderChannel' in data) || data.reminderChannel in ['Calendar & Browser Alert', 'WhatsApp Desk Reminder', 'None'])
        && (!('reminderStatus' in data) || data.reminderStatus in ['pending', 'sent', 'not_needed'])
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAppointmentStatus(data) {
      return data.keys().hasAll([
          'bookingId', 'appointmentId', 'patientInitials', 'departmentName',
          'doctorName', 'opdFee', 'appointmentDate', 'timeSlot',
          'status', 'adminNote', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'bookingId', 'appointmentId', 'patientInitials', 'departmentName',
          'doctorName', 'opdFee', 'appointmentDate', 'timeSlot',
          'status', 'adminNote',
          'reminderTiming', 'reminderChannel', 'reminderStatus',
          'updatedAt'
        ])
        && data.bookingId is string && data.bookingId.size() == 15 && data.bookingId.matches('^SXH-[0-9]{4}-[A-Z0-9]{6}$')
        && isValidId(data.appointmentId)
        && data.patientInitials is string && data.patientInitials.size() >= 1 && data.patientInitials.size() <= 10
        && data.departmentName is string && data.departmentName.size() >= 2 && data.departmentName.size() <= 100
        && data.doctorName is string && data.doctorName.size() >= 2 && data.doctorName.size() <= 100
        && data.opdFee is number && data.opdFee >= 0 && data.opdFee <= 50000
        && isValidDateString(data.appointmentDate)
        && data.timeSlot is string && data.timeSlot.size() >= 3 && data.timeSlot.size() <= 20
        && data.status in ['pending', 'approved', 'rejected', 'completed', 'cancelled']
        && data.adminNote is string && data.adminNote.size() <= 300
        && (!('reminderTiming' in data) || data.reminderTiming in ['24_hours_before', '2_hours_before', 'morning_of_visit', 'none'])
        && (!('reminderChannel' in data) || data.reminderChannel in ['Calendar & Browser Alert', 'WhatsApp Desk Reminder', 'None'])
        && (!('reminderStatus' in data) || data.reminderStatus in ['pending', 'sent', 'not_needed'])
        && data.updatedAt is timestamp;
    }

    function isValidFeedback(data) {
      return data.keys().hasAll(['patientName', 'departmentName', 'doctorName', 'visitType', 'rating', 'comment', 'isPublished', 'createdAt'])
        && data.keys().hasOnly(['patientName', 'departmentName', 'doctorName', 'visitType', 'rating', 'comment', 'isPublished', 'createdAt'])
        && data.patientName is string && data.patientName.size() >= 2 && data.patientName.size() <= 80
        && data.departmentName is string && data.departmentName.size() >= 2 && data.departmentName.size() <= 100
        && data.doctorName is string && data.doctorName.size() <= 100
        && data.visitType in ['OPD Consultation', 'Emergency / Trauma', 'Inpatient Ward', 'Diagnostics / Lab']
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() >= 5 && data.comment.size() <= 500
        && data.isPublished is bool
        && data.createdAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'addedAt'])
        && data.keys().hasOnly(['uid', 'email', 'role', 'addedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 160
        && data.role == 'admin'
        && data.addedAt is timestamp;
    }

    match /departments/{departmentId} {
      allow get: if isValidId(departmentId);
      allow list: if resource.data.isActive == true || isAdmin();
      allow create: if isAdmin() && isValidId(departmentId) && isValidDepartment(incoming()) && incoming().id == departmentId;
      allow update: if isAdmin() && isValidId(departmentId) && isValidDepartment(incoming()) && incoming().id == existing().id && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'nepaliName', 'summary', 'careScope', 'is24x7', 'isActive', 'sortOrder', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(departmentId);
    }

    match /doctors/{doctorId} {
      allow get: if isValidId(doctorId);
      allow list: if resource.data.isAvailable == true || isAdmin();
      allow create: if isAdmin() && isValidId(doctorId) && isValidDoctor(incoming()) && incoming().id == doctorId;
      allow update: if isAdmin() && isValidId(doctorId) && isValidDoctor(incoming()) && incoming().id == existing().id && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'specialty', 'qualification', 'nmcNo', 'opdSchedule', 'photoUrl', 'clinicalFocus', 'departmentId', 'opdFee', 'isAvailable', 'availableSlots', 'sortOrder', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(doctorId);
    }

    match /bookedSlots/{slotLockId} {
      allow get: if isValidId(slotLockId);
      allow list: if resource.data.status == 'active';
      allow create: if isValidId(slotLockId)
        && isValidBookedSlot(incoming())
        && slotLockId == expectedSlotLockId(incoming().doctorId, incoming().appointmentDate, incoming().timeSlot)
        && incoming().createdAt == request.time
        && isDoctorBookable(incoming().doctorId)
        && existsAfter(/databases/$(database)/documents/appointments/$(incoming().appointmentId));
      allow update: if false;
      allow delete: if isAdmin() && isValidId(slotLockId);
    }

    match /appointments/{appointmentId} {
      allow get: if isAdmin() && isValidId(appointmentId);
      allow list: if isAdmin();
      allow create: if isValidId(appointmentId)
        && isValidAppointment(incoming())
        && incoming().status == 'pending'
        && incoming().adminNote == ''
        && incoming().slotLockId == expectedSlotLockId(incoming().doctorId, incoming().appointmentDate, incoming().timeSlot)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isDepartmentBookable(incoming().departmentId)
        && isDoctorBookable(incoming().doctorId)
        && existsAfter(/databases/$(database)/documents/bookedSlots/$(incoming().slotLockId))
        && existsAfter(/databases/$(database)/documents/appointmentStatus/$(incoming().statusLookupId));
      allow update: if isAdmin()
        && isValidId(appointmentId)
        && isValidAppointment(incoming())
        && incoming().bookingId == existing().bookingId
        && incoming().createdAt == existing().createdAt
        && incoming().slotLockId == existing().slotLockId
        && incoming().statusLookupId == existing().statusLookupId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNote', 'reminderStatus', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(appointmentId);
    }

    match /appointmentStatus/{lookupId} {
      allow get: if isValidSha256Id(lookupId);
      allow list: if isAdmin();
      allow create: if isValidSha256Id(lookupId)
        && isValidAppointmentStatus(incoming())
        && incoming().status == 'pending'
        && incoming().adminNote == ''
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/appointments/$(incoming().appointmentId));
      allow update: if isAdmin()
        && isValidSha256Id(lookupId)
        && isValidAppointmentStatus(incoming())
        && incoming().bookingId == existing().bookingId
        && incoming().appointmentId == existing().appointmentId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNote', 'reminderStatus', 'updatedAt']);
      allow delete: if isAdmin() && isValidSha256Id(lookupId);
    }

    match /feedback/{feedbackId} {
      allow get: if isValidId(feedbackId) && (resource.data.isPublished == true || isAdmin());
      allow list: if resource.data.isPublished == true || isAdmin();
      allow create: if isValidId(feedbackId)
        && isValidFeedback(incoming())
        && incoming().isPublished == true
        && incoming().createdAt == request.time;
      allow update: if isAdmin()
        && isValidId(feedbackId)
        && isValidFeedback(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['isPublished']);
      allow delete: if isAdmin() && isValidId(feedbackId);
    }

    match /admins/{adminUid} {
      allow get: if isVerifiedUser() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(adminUid) && isValidAdminUser(incoming()) && incoming().uid == adminUid;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(adminUid);
    }

    match /test/{docId} {
      allow get: if docId == 'connection';
    }
  }
}
